{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}$/)",
        ".write": "!data.exists() && newData.exists() && $code.matches(/^[A-Z]{4}$/) && newData.child('code').val() === $code && newData.hasChildren(['code', 'hostId', 'phase', 'players', 'settings', 'createdAt'])",
        ".validate": "!newData.exists() || (newData.child('code').val() === $code && newData.child('phase').isString() && newData.child('phase').val().matches(/^(lobby|pick_card|roulette|spinning|psychic|voting|reveal|gameover)$/))",
        "code": {
          ".validate": "newData.val() === $code"
        },
        "hostId": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "hostHeartbeatAt": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },
        "phase": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|pick_card|roulette|spinning|psychic|voting|reveal|gameover)$/)"
        },
        "round": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
        },
        "transmitterId": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "psychicId": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "startingTransmitterId": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "clue": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "timerEnd": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.isNumber() && newData.val() <= now + 120000"
        },
        "roundIntroUntil": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.isNumber() && newData.val() <= now + 30000"
        },
        "revealUnlockAt": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.isNumber() && newData.val() <= now + 30000"
        },
        "winner": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "winnerIds": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": true
        },
        "settings": {
          "rounds": {
            ".write": "$code.matches(/^[A-Z]{4}$/)",
            ".validate": "newData.isNumber() && (newData.val() === 5 || newData.val() === 7 || newData.val() === 10 || newData.val() === 15 || newData.val() === 20)"
          },
          "clueTimer": {
            ".write": "$code.matches(/^[A-Z]{4}$/)",
            ".validate": "newData.isNumber() && (newData.val() === 30 || newData.val() === 60 || newData.val() === 90)"
          },
          "voteTimer": {
            ".write": "$code.matches(/^[A-Z]{4}$/)",
            ".validate": "newData.isNumber() && (newData.val() === 30 || newData.val() === 60 || newData.val() === 90)"
          },
          "targetMode": {
            ".write": "$code.matches(/^[A-Z]{4}$/)",
            ".validate": "newData.isString() && (newData.val() === 'random' || newData.val() === 'choose')"
          },
          "cardMode": {
            ".write": "$code.matches(/^[A-Z]{4}$/)",
            ".validate": "newData.isString() && (newData.val() === 'themed' || newData.val() === 'livre')"
          },
          "cardOptions": {
            ".write": "$code.matches(/^[A-Z]{4}$/)",
            ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 3 || newData.val() === 5)"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$playerId": {
            ".write": "$code.matches(/^[A-Z]{4}$/)",
            ".validate": "newData.hasChildren(['id', 'name']) && newData.child('id').val() === $playerId && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 24",
            "id": {
              ".validate": "newData.isString() && newData.val() === $playerId"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "ship": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "shipColor": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "shipAccent": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "connected": {
              ".validate": "newData.isBoolean()"
            },
            "isHost": {
              ".validate": "newData.isBoolean()"
            },
            "isBot": {
              ".validate": "newData.isBoolean()"
            },
            "disconnectedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 300000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "actions": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          "$actionId": {
            ".validate": "newData.hasChildren(['type', 'by', 'ts']) && newData.child('type').isString() && newData.child('type').val().matches(/^(set_ship|set_transmitter|update_settings|start_game|spin_roulette|pick_card|submit_clue|submit_vote|advance_round|emoji_reaction|new_game|back_to_lobby|dev_add_bots|dev_setup_transmitter_test|dev_setup_voter_test|dev_skip_phase|dev_next_psychic)$/) && newData.child('by').isString() && root.child('rooms').child($code).child('players').child(newData.child('by').val()).exists() && newData.child('ts').isNumber() && newData.child('ts').val() >= now - 3600000 && newData.child('ts').val() <= now + 300000"
          }
        },
        "votes": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          "$playerId": {
            ".validate": "root.child('rooms').child($code).child('players').child($playerId).exists() && newData.hasChildren(['position']) && (!newData.child('boost').exists() || newData.child('boost').isBoolean())",
            "position": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "boost": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "psychicSecret": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.hasChildren(['targetPosition']) && newData.child('targetPosition').isNumber() && newData.child('targetPosition').val() >= 0 && newData.child('targetPosition').val() <= 100"
        },
        "currentTheme": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": true
        },
        "currentCard": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": true
        },
        "cardPickOptions": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": true
        },
        "revealResult": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": true
        },
        "roundHistory": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": true
        },
        "usedCardIds": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          "$cardId": {
            ".validate": "newData.isBoolean()"
          }
        },
        "emojiReactions": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          "$reactionId": {
            ".validate": "newData.hasChildren(['playerId', 'playerName', 'emoji', 'ts']) && newData.child('playerId').isString() && newData.child('playerName').isString() && newData.child('playerName').val().length <= 24 && newData.child('emoji').isString() && newData.child('emoji').val().matches(/^(OK|GG|!!|\\?\\?|\\+1)$/) && newData.child('ts').isNumber() && newData.child('ts').val() <= now + 300000"
          }
        },
        "playerScores": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          "$playerId": {
            ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 10000"
          }
        },
        "playerStreaks": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          "$playerId": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
          }
        },
        "finalizeLocks": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          "$round": {
            ".validate": "newData.hasChildren(['hostId', 'round', 'ts']) && newData.child('hostId').isString() && newData.child('round').isNumber() && newData.child('ts').isNumber() && newData.child('ts').val() <= now + 300000"
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },
        "$other": {
          ".write": false,
          ".validate": false
        }
      }
    }
  }
}
