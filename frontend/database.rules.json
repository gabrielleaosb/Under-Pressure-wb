{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}$/)",
        ".write": "$code.matches(/^[A-Z]{4}$/)",
        ".validate": "!newData.exists() || (newData.hasChildren(['code', 'hostId', 'phase', 'players']) && newData.child('code').val() === $code)",
        "players": {
          "$playerId": {
            ".validate": "newData.hasChildren(['id', 'name']) && newData.child('id').val() === $playerId && newData.child('name').isString() && newData.child('name').val().length <= 24"
          }
        },
        "votes": {
          "$playerId": {
            ".validate": "root.child('rooms').child($code).child('players').child($playerId).exists() && newData.hasChildren(['position']) && newData.child('position').isNumber() && newData.child('position').val() >= 0 && newData.child('position').val() <= 100 && (!newData.child('boost').exists() || newData.child('boost').isBoolean())"
          }
        },
        "actions": {
          "$actionId": {
            ".validate": "newData.hasChildren(['type', 'by', 'ts']) && newData.child('type').isString() && newData.child('type').val().length <= 32 && newData.child('by').isString() && root.child('rooms').child($code).child('players').child(newData.child('by').val()).exists() && newData.child('ts').isNumber()"
          }
        },
        "psychicSecret": {
          ".validate": "newData.hasChildren(['targetPosition']) && newData.child('targetPosition').isNumber() && newData.child('targetPosition').val() >= 0 && newData.child('targetPosition').val() <= 100"
        }
      }
    }
  }
}
